{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "mesij hook session-start --actor github-copilot --format copilot",
        "timeoutSec": 10
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "matcher": "edit|write|create|apply_patch",
        "command": "mesij hook pre-edit --format copilot",
        "timeoutSec": 5
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "mesij hook inbox --format copilot",
        "timeoutSec": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "mesij hook inbox --format copilot",
        "timeoutSec": 5
      }
    ]
  }
}
